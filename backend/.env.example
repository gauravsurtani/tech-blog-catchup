# ============================================================
# Backend Environment Variables
# Copy to .env and fill in required values
# ============================================================

# --- Required ---

# Text generation only. Speech runs locally on CPU.
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
API_SIGNING_SECRET=
ENABLE_GENERATION=false
ENABLE_SCHEDULER=false
GENERATION_DAILY_LIMIT=10
MEMBER_DAILY_LIMIT=3
# DATABASE_PATH=/app/data/techblog.db
# KOKORO_ASSET_DIR=/app/models/kokoro

# --- Optional ---

# CORS origins — comma-separated list of allowed frontend URLs
# Default: http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production example: CORS_ORIGINS=https://blog2podcast.com,https://www.blog2podcast.com,http://localhost:3000

# CORS origin regex — optional regex for dynamic subdomain matching
# Matches in addition to CORS_ORIGINS. Useful for preview deploys or subdomains.
# CORS_ORIGIN_REGEX=https://.*\.blog2podcast\.com

# Audio file storage directory
# Default: backend/audio/ (relative to source tree)
# Set to a persistent volume path in production (e.g., /app/audio)
# AUDIO_DIR=/app/audio

# Public URL prefix for serving audio files
# Default: /audio
# AUDIO_BASE_URL=/audio
